# ブラウザからの接続先。本番ではhttps://api.example.com/apiなどを指定する。
# VITE_変数は配布ファイルに含まれるため秘密情報を入れない。
VITE_API_BASE_URL=/api
# Vite開発サーバーだけが使うプロキシ先。
DEV_API_TARGET=http://127.0.0.1:3000
WEB_PORT=5173

# 本番では必須。Google Cloudのウェブアプリ用クライアントID（公開設定）。
VITE_GOOGLE_CLIENT_ID=
# ローカルでGoogleログインを使う場合だけgoogleを指定する。本番ビルドでは常に認証する。
VITE_AUTH_MODE=
