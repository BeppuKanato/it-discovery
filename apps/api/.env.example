# npm workspaceコマンドはapps/apiを作業ディレクトリにする。
HOST=127.0.0.1
PORT=3000
# 開発のViteプロキシには不要。別オリジンから直接呼ぶ場合だけ設定する。
# カンマ区切りのhttp(s)オリジン。パスや末尾の/、*は指定しない。
CORS_ORIGINS=
# apps/apiからの相対パス、または永続ボリューム内の絶対パス。
DATABASE_PATH=./data/it-discovery.db

# ローカル開発だけ認証省略可。本番NODE_ENV=productionではdisabledを拒否する。
AUTH_MODE=disabled
# Google認証を試す場合はAUTH_MODE=googleへ変更する。
GOOGLE_CLIENT_ID=
# Googleの検証済みsubをカンマ区切りで事前登録する。メールアドレスではない。
GOOGLE_ALLOWED_SUBS=

# キャラクター会話。未設定でも他の機能は動く。キーはサーバーだけに置く。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
