{
  "name": "@it-discovery/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --runInBand",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/commands.ts migrate",
    "db:seed": "tsx src/database/commands.ts seed"
  },
  "dependencies": {
    "@it-discovery/contracts": "0.1.0",
    "@nestjs/common": "12.1.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "drizzle-kit": "0.31.11",
    "jest": "30.5.2",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15"
  }
}
